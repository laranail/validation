includes:
    - phpstan-baseline.neon
    - phar://phpstan.phar/conf/bleedingEdge.neon
    - vendor/spaze/phpstan-disallowed-calls/disallowed-dangerous-calls.neon
    - vendor/spaze/phpstan-disallowed-calls/disallowed-execution-calls.neon
    - vendor/spaze/phpstan-disallowed-calls/disallowed-insecure-calls.neon

parameters:
    tmpDir: .cache/phpstan

    paths:
        - src
        - tests

    excludePaths:
        - tests/Fixtures/MacroableFootgun

    level: max

    type_coverage:
        return: 100
        param: 100
        property: 100
        constant: 0
        declare: 100

    # type-perfect ships inside tomasvotruba/type-coverage (it absorbed the
    # standalone rector/type-perfect package). The bundled copy demotes the
    # object-misuse rules below from always-on to opt-in, so they are enabled
    # explicitly here to keep the coverage the standalone package gave us.
    # 2.3.4 removed NoArrayAccessOnObjectRule and its
    # `no_array_access_on_object` key outright — the schema rejects the key,
    # so it cannot stay even as a no-op; composer.json's floor is ^2.3.4 to
    # keep every resolution on the schema this block is written against.
    type_perfect:
        null_over_false: true
        no_mixed: false
        narrow_param: false
        narrow_return: true
        no_param_type_removal: true
        no_isset_on_object: true
        no_empty_on_object: true

    cognitive_complexity:
        class: 80
        function: 20

    strictRules:
        allRules: true

    editorUrl: 'phpstorm://open?file=%%file%%&line=%%line%%'

    treatPhpDocTypesAsCertain: false

    ignoreErrors:
        -
            identifier: trait.unused
            reportUnmatched: false
        - identifier: ternary.condNotBoolean
        # FluentRuleContract's when/unless match Laravel's Conditionable trait
        # signature exactly (untyped $value, no return type) — adding native
        # types here would break LSP compatibility with the trait.
        -
            identifier: typeCoverage.paramTypeCoverage
            path: src/Contracts/FluentRuleContract.php
            reportUnmatched: false
        -
            identifier: typeCoverage.returnTypeCoverage
            path: src/Contracts/FluentRuleContract.php
            reportUnmatched: false

        # Pest $this->fail() in closures — PHPStan can't resolve $this to TestCase
        -
            identifier: method.notFound
            path: tests/
            reportUnmatched: false

        # Pest framework internals — expect() chains use Pest's internal Expectation class
        -
            identifier: method.internalClass
            path: tests/
            reportUnmatched: false
        # PHPUnit's AssertionFailedError / ExpectationFailedException are marked @internal
        # but legitimately referenced from tests when asserting on assertion failures
        -
            identifier: classConstant.internalClass
            path: tests/
            reportUnmatched: false
        # Tests for first-party @internal classes (ConditionalEvaluationPhase,
        # RuleConfigBuilder, etc.) — direct unit tests must instantiate / call
        # the very classes whose @internal annotation tells external consumers
        # to stay out. The annotation still serves its purpose at the package
        # boundary; tests are inside that boundary.
        -
            identifier: new.internalClass
            path: tests/
            reportUnmatched: false
        -
            identifier: classConstant.internalEnum
            path: tests/
            reportUnmatched: false
        -
            identifier: staticMethod.internalClass
            path: tests/
            reportUnmatched: false
        -
            identifier: staticMethod.internal
            path: tests/
            reportUnmatched: false
        # Pest higher-order expectations and test helpers return mixed
        -
            identifier: method.nonObject
            path: tests/
            reportUnmatched: false
        -
            identifier: staticMethod.dynamicCall
            path: tests/
            reportUnmatched: false
        -
            identifier: offsetAccess.nonOffsetAccessible
            path: tests/
            reportUnmatched: false
        -
            identifier: property.nonObject
            path: tests/
            reportUnmatched: false
        -
            identifier: property.notFound
            path: tests/
            reportUnmatched: false
        # Pest arch test API (->expect()->each->not->...)
        -
            identifier: method.notFound
            path: tests/ArchTest.php
            reportUnmatched: false
        # Pest Arch's ArchExpectation interface is marked @internal but its
        # fluent API (->ignoring(), ->toOnlyUse(), etc.) is precisely how the
        # public Arch API is meant to be used.
        -
            identifier: method.internalInterface
            path: tests/ArchTest.php
            reportUnmatched: false
