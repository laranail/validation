parameters:
	ignoreErrors:
		# Every complexity.* value below was re-measured on 2026-10-05 with
		# tomasvotruba/cognitive-complexity 1.3.0, whose scoring differs from
		# 1.2.0 (which the earlier numbers in the comments below were written
		# against). No source changed between the two measurements, so the
		# difference is the scorer's alone; composer.json floors the package at
		# ^1.3 so a prefer-lowest resolve scores on the same scale.
		# 1.2.0 -> 1.3.0: RuleConfigBuilder class 118 -> 155, buildValueClosure
		# 52 -> 76; ItemContextCompiler class 98 -> 125, buildItemAwareClosure
		# 59 -> 86; PresenceConditionalCompiler::compile 25 -> 24; RuleSet class
		# 141 -> 157; ItemRuleCompiler class 88 -> 111, buildFastChecks 46 -> 68;
		# ItemValidator::validate 49 -> 64. BatchDatabaseChecker and
		# DoctorCommand::handle were under the limits on 1.2.0 and are new here.
		# Hot-path closure builders: complexity comes from intentional
		# inlining (size, in/regex, date comparisons) to avoid closure
		# allocation + call overhead on every validated item.
		# Factoring out hurts benchmark numbers; keep inlined + baselined.
		# Relocated from CoreValueCompiler to RuleConfigBuilder in the
		# May 2026 maintainability refactor — same code, new home.
		# Raised 115 -> 120 by the Laravel-parity fixes: calendarTimestamp()
		# (validateDate also runs checkdate, not just strtotime) and
		# parseSize() (min:/max: must keep fractional precision). Both are
		# extracted helpers, so addDateChecks() stayed under its own limit.
		# Lowered 120 -> 118 by the Phase-0a verdict-parity fixes (P1-P4):
		# the compile-combination guard is lean, timestampWithinBounds()
		# was extracted, and addDateChecks() dropped under its own limit —
		# its entry is gone.
		-
			rawMessage: 'Class cognitive complexity is 155, keep it under 80'
			identifier: complexity.classLike
			count: 1
			path: src/FastCheck/RuleConfigBuilder.php

		-
			rawMessage: 'Cognitive complexity for "Simtabi\Laranail\Validation\FastCheck\RuleConfigBuilder::buildValueClosure()" is 76, keep it under 20'
			identifier: complexity.functionLike
			count: 1
			path: src/FastCheck/RuleConfigBuilder.php

		-
			rawMessage: 'Class cognitive complexity is 125, keep it under 80'
			identifier: complexity.classLike
			count: 1
			path: src/FastCheck/ItemContextCompiler.php

		-
			rawMessage: 'Cognitive complexity for "Simtabi\Laranail\Validation\FastCheck\ItemContextCompiler::buildItemAwareClosure()" is 86, keep it under 20'
			identifier: complexity.functionLike
			count: 1
			path: src/FastCheck/ItemContextCompiler.php

		-
			rawMessage: 'Cognitive complexity for "Simtabi\Laranail\Validation\FastCheck\PresenceConditionalCompiler::compile()" is 24, keep it under 20'
			identifier: complexity.functionLike
			count: 1
			path: src/FastCheck/PresenceConditionalCompiler.php

		# Grew by one with Phase 2's runValidateInternal remap layer, and by one
		# more with the separateRules() malformed-wildcard guard — a single
		# conditional throw that converts a silent validation bypass (a '*' key
		# with no '.*' segment applied no rule) into a loud error. The +1 is
		# irreducible for a guard, and dropping RuleSet below the 80 threshold is a
		# whole-class refactor out of scope here. Grew by five more with the
		# object-form wildcard-dep fix and its codex-review hardening:
		# rewriteRulesForPerItem normalizes FluentRule objects to native form so
		# conditional deps like requiredUnless('items.*.type', …) get the wildcard
		# prefix stripped per item — stripping the whole compiled string (not an
		# explode that would corrupt a regex token like regex:/^(a|b)$/) — plus the
		# metadata-before-rewrite reorder in validateWildcardGroups. The
		# per-function complexity stays under 20 (logic in stripPrefixFromConstraints);
		# only the class total moves.
		# Dropped 145 -> 135 by the php84 Rector sweep, which replaced several
		# foreach loops with array_any()/array_all(). validateInternal() fell
		# below 20 in the same pass and its entry is gone entirely.
		# Raised 135 -> 141 by the Phase-1 extension seams: the §5.6 event
		# lifecycle (compiling mutation, starting/completed/failed), the
		# before()/after() hooks in runValidateInternal(), and toSchema()'s
		# missing-dependency guard. The after() route itself lives in
		# Internal\VanillaAfterRoute, not here.
		-
			rawMessage: 'Class cognitive complexity is 157, keep it under 80'
			identifier: complexity.classLike
			count: 1
			path: src/RuleSet.php

		# Inherently-complex per-item rule compiler: buildFastChecks (46) dominates
		# the class total, and evaluating every exclude_* condition per field
		# (fieldIsExcluded + findCommonDispatchField) adds irreducible branching
		# for native-parity. Dropping the class under 80 is a whole-class refactor
		# out of scope.
		-
			rawMessage: 'Class cognitive complexity is 111, keep it under 80'
			identifier: complexity.classLike
			count: 1
			path: src/Internal/ItemRuleCompiler.php

		# buildFastChecks branches over field-shape × closure-type (wildcard vs
		# flat × item-aware vs value-only) — structural complexity that
		# refactoring would only move.
		-
			rawMessage: 'Cognitive complexity for "Simtabi\Laranail\Validation\Internal\ItemRuleCompiler::buildFastChecks()" is 68, keep it under 20'
			identifier: complexity.functionLike
			count: 1
			path: src/Internal/ItemRuleCompiler.php


		# Phase 2b: RuleSet::validateItems body relocated verbatim to
		# ItemValidator::validate. Complexity is identical (49) — the loop's
		# nested fast-check → dispatch-cache → validator-cache structure
		# carries the score, and refactoring those caches has measurable
		# perf cost (per-item validator reuse + dispatch reduction).
		-
			rawMessage: 'Cognitive complexity for "Simtabi\Laranail\Validation\Internal\ItemValidator::validate()" is 64, keep it under 20'
			identifier: complexity.functionLike
			count: 1
			path: src/Internal/ItemValidator.php

		# New on cognitive-complexity 1.3.0 (under the limits on 1.2.0, same code).
		-
			rawMessage: 'Class cognitive complexity is 100, keep it under 80'
			identifier: complexity.classLike
			count: 1
			path: src/BatchDatabaseChecker.php

		-
			rawMessage: 'Cognitive complexity for "Simtabi\Laranail\Validation\BatchDatabaseChecker::collectValues()" is 22, keep it under 20'
			identifier: complexity.functionLike
			count: 1
			path: src/BatchDatabaseChecker.php

		-
			rawMessage: 'Cognitive complexity for "Simtabi\Laranail\Validation\BatchDatabaseChecker::collectExpandedValues()" is 23, keep it under 20'
			identifier: complexity.functionLike
			count: 1
			path: src/BatchDatabaseChecker.php

		-
			rawMessage: 'Cognitive complexity for "Simtabi\Laranail\Validation\Commands\DoctorCommand::handle()" is 23, keep it under 20'
			identifier: complexity.functionLike
			count: 1
			path: src/Commands/DoctorCommand.php

		# Cross-version Filament guard. The trait may be mixed into components
		# that lack getCachedForms (plain Livewire without InteractsWithForms),
		# so the method_exists() check is required at runtime. PHPStan only ever
		# analyses the trait through the single test double, which declares
		# getCachedForms, making the guard look always-true in that sole
		# context. Inline @phpstan-ignore in a trait does not apply to
		# using-class-context analysis (newer larastan), so it is baselined.
		-
			rawMessage: 'Call to function method_exists() with $this(TestableFilamentComponent) and ''getCachedForms'' will always evaluate to true.'
			identifier: function.alreadyNarrowedType
			count: 2
			path: tests/HasFluentValidationForFilamentTest.php
